{
  "version": 6,
  "configurePresets": [
    {
      "name": "hook",
      "displayName": "i686 hook/oracle build (against original NgBMX.exe)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/hook",
      "toolchainFile": "${sourceDir}/cmake/i686-windows-freestanding.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "BMX_HOOK": "ON" }
    },
    {
      "name": "native32",
      "displayName": "i686 native exe (OpenFreestyleBMX.exe, llvm-mingw; test build)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native32",
      "toolchainFile": "${sourceDir}/cmake/i686-mingw.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "BMX_HOOK": "OFF", "BMX_NATIVE32": "ON" }
    },
    {
      "name": "native64",
      "displayName": "x86_64 native exe (OpenFreestyleBMX.exe, llvm-mingw; the release build)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native64",
      "toolchainFile": "${sourceDir}/cmake/x86_64-mingw.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "BMX_HOOK": "OFF", "BMX_NATIVE32": "ON" }
    },
    {
      "name": "macos",
      "displayName": "macOS arm64 native exe (bmxnative, host clang, SDL3 from nix; docs/PORTING.md X5)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "BMX_HOOK": "OFF",
        "BMX_NATIVE32": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "linux",
      "displayName": "Linux x86_64 native exe (bmxnative, host clang, SDL3 via CMake config; docs/PORTING.md X4)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "toolchainFile": "${sourceDir}/cmake/x86_64-linux.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "BMX_HOOK": "OFF", "BMX_NATIVE32": "ON" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "android",
      "displayName": "Android arm64-v8a libmain.so (NDK, SDL3 from tools/android_sdl3.sh; docs/PORTING.md X6)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android",
      "toolchainFile": "${sourceDir}/cmake/aarch64-android.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BMX_HOOK": "OFF",
        "BMX_NATIVE32": "ON",
        "SDL3_DIR": "${sourceDir}/build/android-sdl3/prefix/lib/cmake/SDL3"
      }
    }
  ],
  "buildPresets": [
    { "name": "hook", "configurePreset": "hook" },
    { "name": "native32", "configurePreset": "native32" },
    { "name": "native64", "configurePreset": "native64" },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "android", "configurePreset": "android" }
  ]
}
